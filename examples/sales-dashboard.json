{
  "name": "Sales Performance",
  "overwrite": true,
  "model": {
    "tables": [
      {
        "name": "Product",
        "description": "Product dimension",
        "columns": [
          { "name": "ProductKey", "type": "int64", "summarizeBy": "none", "hidden": true },
          { "name": "Product", "type": "string" },
          { "name": "Category", "type": "string" }
        ],
        "rows": [
          [1, "Trail Bike", "Bikes"],
          [2, "Road Bike", "Bikes"],
          [3, "Helmet", "Accessories"],
          [4, "Jersey", "Clothing"],
          [5, "Gloves", "Accessories"]
        ]
      },
      {
        "name": "Sales",
        "description": "Sales fact table",
        "columns": [
          { "name": "Date", "type": "date", "format": "yyyy-mm-dd" },
          { "name": "ProductKey", "type": "int64", "summarizeBy": "none" },
          { "name": "Region", "type": "string" },
          { "name": "Quantity", "type": "int64", "format": "#,##0" },
          { "name": "Amount", "type": "double", "format": "$ #,##0" }
        ],
        "rows": [
          ["2024-01-05", 1, "North", 2, 2400],
          ["2024-01-12", 2, "North", 1, 1800],
          ["2024-01-19", 3, "West", 4, 320],
          ["2024-02-02", 1, "South", 3, 3600],
          ["2024-02-09", 4, "West", 6, 540],
          ["2024-02-16", 2, "North", 2, 3600],
          ["2024-03-01", 5, "South", 10, 250],
          ["2024-03-08", 1, "West", 1, 1200],
          ["2024-03-15", 4, "North", 4, 360],
          ["2024-04-05", 2, "South", 2, 3600],
          ["2024-04-12", 3, "West", 5, 400],
          ["2024-04-19", 1, "North", 2, 2400],
          ["2024-05-03", 5, "South", 8, 200],
          ["2024-05-10", 4, "West", 3, 270],
          ["2024-05-17", 2, "North", 1, 1800]
        ],
        "measures": [
          {
            "name": "Total Sales",
            "expression": "SUM('Sales'[Amount])",
            "format": "$ #,##0",
            "folder": "KPIs",
            "description": "Total revenue"
          },
          {
            "name": "Total Quantity",
            "expression": "SUM('Sales'[Quantity])",
            "format": "#,##0",
            "folder": "KPIs"
          },
          {
            "name": "Average Sale",
            "expression": "DIVIDE([Total Sales], COUNTROWS('Sales'))",
            "format": "$ #,##0.00",
            "folder": "KPIs"
          }
        ]
      }
    ],
    "relationships": [
      {
        "from": "Sales[ProductKey]",
        "to": "Product[ProductKey]",
        "cardinality": "manyToOne"
      }
    ]
  },
  "pages": [
    {
      "title": "Sales Performance",
      "displayName": "Overview",
      "visuals": [
        { "type": "card", "values": ["Sales[Total Sales]"], "title": "Revenue", "x": 24, "y": 88, "width": 296, "height": 104 },
        { "type": "card", "values": ["Sales[Total Quantity]"], "title": "Units sold", "x": 336, "y": 88, "width": 296, "height": 104 },
        { "type": "card", "values": ["Sales[Average Sale]"], "title": "Average sale", "x": 648, "y": 88, "width": 296, "height": 104 },
        { "type": "slicer", "field": "Product[Category]", "title": "Category", "x": 960, "y": 88, "width": 296, "height": 104 },
        {
          "type": "bar",
          "title": "Revenue by category",
          "category": "Product[Category]",
          "values": ["Sales[Total Sales]"],
          "sort": "desc",
          "legend": false,
          "dataLabels": true,
          "x": 24,
          "y": 208,
          "width": 600,
          "height": 480
        },
        {
          "type": "line",
          "title": "Revenue trend",
          "category": "Sales[Date]",
          "values": ["Sales[Total Sales]"],
          "legend": false,
          "x": 640,
          "y": 208,
          "width": 616,
          "height": 480
        }
      ]
    },
    {
      "title": "Sales detail",
      "displayName": "Detail",
      "visuals": [
        {
          "type": "table",
          "title": "Transactions",
          "values": ["Sales[Date]", "Product[Product]", "Product[Category]", "Sales[Region]", "Sales[Quantity]", "Sales[Amount]"],
          "x": 24,
          "y": 88,
          "width": 1232,
          "height": 560
        }
      ]
    }
  ]
}
